# Neon
DATABASE_URL=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
CLERK_WEBHOOK_SIGNING_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed — correo del primer super administrador. La persona debe existir ya en la
# tabla `users` (registrarse una vez); `npm run db:seed` le otorga el rol.
SEED_SUPER_ADMIN_EMAIL=""

# Stripe (docs/stripe/checkout-integration.md)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SIGNING_SECRET=""

# ---------------------------------------------------------------------------
# Facturación electrónica (spec 022)
# ---------------------------------------------------------------------------
# Emisor: datos fiscales de la empresa. Sin panel de configuración (spec 022,
# D-18): son tres valores que cambian cuando cambia la empresa, es decir, nunca,
# y una tabla con CRUD crearía la posibilidad de emitir cien comprobantes con el
# RUC mal tecleado. `src/lib/invoicing-config.ts` lanza al importarse si falta
# cualquiera de las cinco de abajo, igual que `src/lib/stripe.ts`.
INVOICING_COMPANY_RUC=""
INVOICING_COMPANY_LEGAL_NAME=""
INVOICING_COMPANY_ADDRESS=""

# Nubefact (OSE/PSE autorizado SUNAT). La URL es la «RUTA» que el panel de
# Nubefact asigna a la empresa; el token es **secreto de servidor** y en Vercel se
# marca como sensitive, igual que STRIPE_SECRET_KEY.
NUBEFACT_API_URL=""
NUBEFACT_API_TOKEN=""

# Series con las que `npm run db:seed` crea las 6 filas de `document_series`.
# **Solo las lee el seed**: en runtime la serie vigente sale de la tabla, y una fila
# ya creada no se reescribe desde aquí para no romper la correlatividad. Tienen que
# estar dadas de alta en el panel de Nubefact antes de emitir.
NUBEFACT_SERIES_BOLETA="B001"
NUBEFACT_SERIES_FACTURA="F001"
NUBEFACT_SERIES_NOTA_CREDITO_BOLETA="BC01"
NUBEFACT_SERIES_NOTA_CREDITO_FACTURA="FC01"
NUBEFACT_SERIES_NOTA_DEBITO_BOLETA="BD01"
NUBEFACT_SERIES_NOTA_DEBITO_FACTURA="FD01"
